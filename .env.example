# ---- Remember: environment ----
PORT=3000

# Where SQLite, uploads and the local model cache live.
# On Render, point this at your mounted persistent disk (e.g. /var/data).
DATA_DIR=./data

# ---- Open-source AI ----
# Local embedding model (open weights, Apache-2.0). Runs on-device via ONNX.
# Nothing leaves your server. Leave as-is unless you want a different open model.
EMBEDDING_MODEL=Xenova/all-MiniLM-L6-v2

# Optional: an open-weight LLM for richer prose. ANY OpenAI-compatible endpoint
# works, so you can self-host (Ollama, llama.cpp, vLLM) or use a hosted
# open-weight provider. Leave blank and Remember still works fully.
#
# Local Ollama example:
#   OPEN_MODEL_BASE_URL=http://localhost:11434/v1
#   OPEN_MODEL_NAME=qwen2.5:7b-instruct
#
# Hosted open-weight example (Together / Groq / Fireworks / OpenRouter):
#   OPEN_MODEL_BASE_URL=https://api.together.xyz/v1
#   OPEN_MODEL_NAME=Qwen/Qwen2.5-7B-Instruct-Turbo
#   OPEN_MODEL_API_KEY=your-key
OPEN_MODEL_BASE_URL=
OPEN_MODEL_NAME=
OPEN_MODEL_API_KEY=
